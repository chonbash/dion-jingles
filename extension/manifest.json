{
  "manifest_version": 3,
  "name": "Dion Jingles",
  "version": "1.0.0",
  "description": "Воспроизведение звуковых джинглов во время видеоконференций на dion.vc",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://dion.vc/*",
    "https://*.dion.vc/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dion.vc/*",
        "https://*.dion.vc/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dion.vc/*",
        "https://*.dion.vc/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*"
      ],
      "matches": [
        "https://dion.vc/*",
        "https://*.dion.vc/*"
      ]
    }
  ]
}
